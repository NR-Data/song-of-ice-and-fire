        "rules": [
          {
            "name": "Description",
            "id": "a29a-7bf5-b673-d0a6",
            "description": "While simply armored and lightly armed, Bolton Cutthorats enjoy a reputation for brutality and cold efficiency that allows them to strike panic on enemies with far more empensive armaments. Their spiked maces can easily dispatch enemies, but are more effective for the fear their brutality creates. Bolton Cutthroats make sport of downed foes or, worse for the opponent, take them prisoner to suffer a much more agonizing fate.",
            "hidden": false
          }
        ]

        ],
        "rules": [
          {
            "name": "Description",
            "id": "dd1d-8620-4b4b-dd6a",
            "description": "The sheer ruthlessness of the Dreadfort Blackguards became infamous across all forces in the War of the Five Kings. Their vicious spiked flails rendered heavy shields only moderately effective at best, and House Bolton's reputation gave even hardened veterans pause when engaging them in battle. As the heaviest troops House Bolton fielded, the Blackguards could be relied upon as a solid vanguard, holding any position on the battlefield.",
            "hidden": false
          }

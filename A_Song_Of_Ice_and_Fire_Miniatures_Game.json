    "sharedRules": [
      {
        "name": "Spiked Mace",
        "id": "a792-418a-2a3b-79f3",
        "description": "- If this attack targets an enemy that has not activated this round, that enemy become Vulnerable.\n- Vicious (Defenders suffer -2 to their Panic Tests).",
        "hidden": false
      },
      {
        "name": "Spread Fear",
        "id": "ab91-68f9-d096-999f",
        "description": "Each time an enemy engaged with this unit fails a Panic Test, 1 other enemy within Long Range of that unit becomes Panicked.",
        "hidden": false
      },
      {
        "name": "Tracker's Bow",
        "id": "02fe-6de3-7a93-9c78",
        "description": "- Long Range\n- If the defener rolls a 1 on any Defense Saves, they become Vulnerable.",
        "hidden": false
      },
      {
        "name": "Master and Pets",
        "id": "96df-b554-7ae0-905a",
        "description": "Hound models are removed from this unit before other models (moving other models up to fill in missing slots).",
        "hidden": false
      },
      {
        "name": "Order: Sic'em",
        "id": "c185-93fb-ea4a-be6e",
        "description": "After this unit completes a Ranged Attack: this unit may make a free Charge action against the targeted enemy.",
        "hidden": false
      },
      {
        "name": "War Flail",
        "id": "bd64-2d7b-e95e-a5ac",
        "description": "- Critical Blow (Rolls of 6 cause 2 Hits).\n- Vicious (Defenders suffer -2 to their Panic Tests).",
        "hidden": false
      },
      {"name": "Ferocious Assault", "id": "7a4e-a35b-ddc8-014a", "description": "Enemies successfully Charged by this unit become Panicked.", "hidden": false},
      {
        "name": "Cavalry",
        "id": "56ab-31ff-2708-c161",
        "description": "Each model in this unit has 3 Wounds.\nAt the start of this unit's activation, it may make a free Maneuver action.",
        "hidden": false
      },
      {"name": "Affiliation: House Bolton", "id": "54f7-0f33-4c46-7acc", "description": "This unit counts as a House Bolton unit.", "hidden": false},
      {"name": "Spiked Flail", "id": "2cd3-ab65-20cb-1ff8", "description": "- Vicious (Defenders suffer -2 to their Panic Tests).", "hidden": false},
      {
        "name": "Spiked Armor",
        "id": "ffee-5306-1117-4c00",
        "description": "When this unit is attacked with melee, for each Defense Save roll of a 6, the attacker suffers 1 Wound.",
        "hidden": false
      },
      {"name": "Insignificant", "id": "6107-0f43-e306-39fd", "description": "This unit is not worth Victory Points from Victory Through Combat.", "hidden": false}
